# =====================================================================
# Serverfitpower - Configuración central (leída por todos los scripts)
# =====================================================================

# --- Sistema -------------------------------------------------------
HOSTNAME_SRV="Serverfitpower"

# --- Red (solo si CONFIGURAR_RED="si"; en un VPS poner "no") ----------
CONFIGURAR_RED="si"
IFACE=""                      # vacío = autodetectar
IP_FIJA="192.168.1.3/24"
GATEWAY="192.168.1.1"
DNS_SERVERS="8.8.8.8,1.1.1.1"

# --- Contraseñas de usuarios ---------------------------------------
PASS_ADMIN='Adm1n#Fit-Srv26'
PASS_SUBADMIN='Sub4dm#Fit-Ssh26'
PASS_ESTANDAR='Est4nd#Fit-Usr26'

# --- Dominio y SSL (completar) -------------------------------------
DOMINIO=""                    # ej: fitpower.midominio.com
EMAIL_SSL=""                  # correo para Let's Encrypt

# --- Programa en GitHub (completar) --------------------------------
REPO_URL=""                   # ej: https://github.com/usuario/repositorio.git
REPO_RAMA="main"
DIR_WEB="/var/www/fitpower"

# --- Base de datos -------------------------------------------------
DB_NOMBRE="fitpower_db"
DB_USUARIO="fitpower_user"

# --- Respaldos -----------------------------------------------------
DIR_BACKUPS="/srv/backups"
B2_BUCKET="fitpower"
B2_KEY_ID=""                  # keyID de Backblaze B2 (completar)
B2_APP_KEY=""                 # applicationKey de Backblaze B2 (completar)
export RCLONE_CONFIG="/etc/fitpower/rclone.conf"
